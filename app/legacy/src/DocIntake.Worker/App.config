<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!--
      Storage selection via a single key, mirroring Bob's Used Books Classic FileService. Stage 0:
      smb. Stage 1: nfs. Stage 3 (Lambda): s3. The key name is "Store"; a mismatch with the code's
      expected key is exactly the MP-25 observation the migration should surface.
    -->
    <add key="Store" value="smb" />
    <!-- UNC root of the SMB share for stage 0. -->
    <add key="SmbRoot" value="\\APPMODSVM01\appdata" />
    <!-- Stage sub-directory under out/ the Worker writes to. -->
    <add key="Stage" value="s0" />
  </appSettings>
</configuration>
