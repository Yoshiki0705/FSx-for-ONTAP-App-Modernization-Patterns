<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SDK-style console project targeting .NET 10 (LTS). Migrated from old-style ToolsVersion 4.0 /
    .NET Framework 4.8 (ADR-1). No NuGet dependencies. The appmod-probe/1 JSON output is a wire
    format consumed by external merge/compare scripts and compared against the s0/s1/s4c/s3b
    baselines, so it is hand-built and kept byte-stable (AP-7 is NOT applied to the Probe to avoid
    wire-format drift — see adaptation-ledger AP-7).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DocIntake.Probe</RootNamespace>
    <AssemblyName>DocIntake.Probe</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Product>DocIntake</Product>
    <AssemblyTitle>DocIntake.Probe</AssemblyTitle>
    <Description>Behavioral measurement probe for the DocIntake sample app.</Description>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ComVisible>false</ComVisible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DocIntake.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DocIntake.Core\DocIntake.Core.csproj" />
  </ItemGroup>

</Project>
