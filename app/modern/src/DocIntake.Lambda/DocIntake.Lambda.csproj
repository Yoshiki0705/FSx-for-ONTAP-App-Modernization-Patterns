<Project Sdk="Microsoft.NET.Sdk">
  <!-- Stage-3 AWS Lambda handler: DocIntake.Lambda::DocIntake.Lambda.Function::Handler (the
       templates/stage3-serverless.yaml LambdaHandler default in the Spoke). Class library for the
       managed dotnet10 runtime; packaging commands are in BUILD.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DocIntake.Lambda</RootNamespace>
    <AssemblyName>DocIntake.Lambda</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <AWSProjectType>Lambda</AWSProjectType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DocIntake.Core\DocIntake.Core.csproj" />
    <ProjectReference Include="..\DocIntake.Worker\DocIntake.Worker.csproj" />
    <ProjectReference Include="..\DocIntake.Probe\DocIntake.Probe.csproj" />
  </ItemGroup>
  <!-- Exact pins, no ranges, so a rebuilt zip resolves the same assemblies. Amazon.Lambda.Core 3.4.0
       (ILambdaContext, LambdaSerializer), Amazon.Lambda.Serialization.SystemTextJson 3.0.1
       (DefaultLambdaJsonSerializer), AWSSDK.S3 4.0.104.2 (the same pin as DocIntake.Core, stated here
       because Function calls it directly). -->
  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.Core" Version="3.4.0" />
    <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" Version="3.0.1" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.8" />
  </ItemGroup>
</Project>
