# Environment file for docintake-bgworker.service. Copy to /etc/docintake-bgworker.env and edit.
# Every DOCINTAKE_* variable is required; the worker exits at startup if any is missing or malformed.

# .NET 10 install root (the dotnet host the unit's ExecStart invokes).
DOTNET_ROOT=/opt/dotnet

# NFS mount root for the worker's data (inbox, reports, and the .claims directory live under here).
DOCINTAKE_ROOT=/mnt/appdata

# Control-plane record file. Keep it OUTSIDE DOCINTAKE_ROOT (local disk), so postconditions survive
# an NFS-side cleanup. The worker rejects a control-plane path inside the appdata root.
DOCINTAKE_CONTROL_PLANE_PATH=/var/lib/docintake/controlplane/events.jsonl

# Stage name; output reports are written under out/<stage>/reports/.
DOCINTAKE_STAGE=stage-nfs

# Owner id recorded on claims this worker takes. Make it unique per worker instance.
DOCINTAKE_OWNER_ID=worker-1

# Claim lease seconds. The worker renews within the lease; a crashed owner's claim expires after this.
DOCINTAKE_CLAIM_LEASE_SECONDS=30

# Max processing attempts per item before a failure is final.
DOCINTAKE_MAX_ATTEMPTS=3

# Delay between retry attempts, milliseconds.
DOCINTAKE_RETRY_DELAY_MS=200

# Poll interval between inbox scans, milliseconds.
DOCINTAKE_POLL_INTERVAL_MS=1000

# Control-plane operation timeout, milliseconds.
DOCINTAKE_CONTROL_PLANE_TIMEOUT_MS=5000
